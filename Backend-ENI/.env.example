# Entorno
NODE_ENV=production
PORT=3000

# Base de Datos (PostgreSQL en Vercel Postgres / Neon / Supabase / Railway)
# Opción 1: Cadena completa de conexión (Recomendado para Vercel Postgres / Neon / Supabase)
DATABASE_URL=postgresql://usuario:password@ep-host.region.aws.neon.tech/eni_db?sslmode=require

# Opción 2: Parámetros individuales (si no usas DATABASE_URL)
DB_DIALECT=postgres
DB_HOST=ep-host.region.aws.neon.tech
DB_PORT=5432
DB_NAME=eni_db
DB_USER=usuario
DB_PASS=password
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

# Autenticación y Seguridad
JWT_SECRET=tu_clave_secreta_jwt_muy_segura_de_al_menos_32_caracteres
JWT_EXPIRES_IN=2h
RATE_LIMIT_MAX=600

# CORS
# En producción coloca el dominio de tu frontend en Vercel
FRONTEND_ORIGIN=https://tu-frontend.vercel.app

# Google reCAPTCHA (v3 o v2 invisible)
CAPTCHA_SECRET=tu_google_recaptcha_secret_key
# Pon true si deseas omitir validación captcha en pruebas
CAPTCHA_DISABLED=false

# Google Drive (Almacenamiento de evidencias en la nube)
# Opcional: Pon false para no exigir Google Drive
GOOGLE_DRIVE_REQUIRED=false
GOOGLE_DRIVE_FOLDER_ID=1Bx5FZ7aEECGqisCFeeNcozHSjJz5P-IV

# Opción OAuth2 para Drive (Recomendado):
GOOGLE_OAUTH_CLIENT_ID=tu_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=tu_client_secret
GOOGLE_OAUTH_REFRESH_TOKEN=tu_refresh_token
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# Opción Service Account en JSON stringificado (Alternativa para Vercel Env):
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Cron jobs (Deshabilitado en Serverless de Vercel porque no tiene procesos daemon)
DISABLE_CRON=true
